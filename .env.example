# Copy to .env for non-secret settings; npm run assistant / test:live read it if present.
# Entra credentials stay in the backend (az login). Never put tokens, keys or the password here.
# Set LIVE_ASSISTANT_PASSWORD (16+ characters) only in the process environment.
# Everything below except STATE, PORT, ORIGIN and CHROMIUM is only a default: the page settings dialog (avatar menu)
# overrides it at runtime and stores the overrides in <state>/settings.json.

# Foundry models for voice, read-aloud and the intent interpreter; harness models come from each CLI's own configuration.
# Each model names its own Foundry resource root, so they may sit in different regions; a model without an endpoint
# is unavailable (with none set, only the terminals remain).
# The subscription only selects the az login tenant for the token: every resource must be in that tenant (any of its
# subscriptions), with an Azure AI role granted to you on the resource.
AZURE_SUBSCRIPTION_NAME=<authorized-subscription-name>

# Live voice, here sharing one resource with read-aloud. The voice is fixed per connection and applies on the next connect.
FOUNDRY_LIVE_ENDPOINT=https://<voice-resource>.openai.azure.com
# FOUNDRY_LIVE_DEPLOYMENT=gpt-live-1
# FOUNDRY_LIVE_VOICE=marin

# Read-aloud; the voice must be one the TTS deployment supports.
FOUNDRY_TTS_ENDPOINT=https://<voice-resource>.openai.azure.com
# FOUNDRY_TTS_DEPLOYMENT=gpt-4o-mini-tts
# FOUNDRY_TTS_VOICE=alloy

# Intent interpreter, here on a resource in another region. GPT deployments only (strict JSON schema);
# effort none|minimal|low|medium|high|xhigh, support varies by model.
FOUNDRY_INTENT_ENDPOINT=https://<intent-resource>.openai.azure.com
# Suggested: gpt-6.1-terra is newer and faster than the built-in default gpt-6.1-sol.
FOUNDRY_INTENT_DEPLOYMENT=gpt-6.1-terra
# FOUNDRY_INTENT_EFFORT=low

# Local state and the workspace; sessions start in <workspace>/<harness>-work by default.
# LIVE_ASSISTANT_STATE=/absolute/path/to/private/state
# LIVE_ASSISTANT_WORKSPACE=/absolute/path/to/disposable/workspace
# Extra roots (PATH-style list) where custom session directories may live, subdirectories included.
# LIVE_ASSISTANT_ROOTS=/absolute/path/a:/absolute/path/b
# DSH profile started as `dsh --profile <profile>`.
# LIVE_ASSISTANT_DSH_PROFILE=dsh-tui
# Set to 1 to give each DSH session a short-lived Entra token as FOUNDRY_TOKEN (uses AZURE_SUBSCRIPTION_NAME).
# LIVE_ASSISTANT_DSH_FOUNDRY_TOKEN=0
# LIVE_ASSISTANT_PORT=8787
# Exact browser origin when served through an HTTPS reverse proxy.
# LIVE_ASSISTANT_ORIGIN=https://<host>
# Verification command timeout in seconds (default 600).
# LIVE_ASSISTANT_VERIFY_TIMEOUT=600
# Largest file the page may upload into a session directory, in MiB.
# LIVE_ASSISTANT_UPLOAD_MB=2048
# Set to 0 to disable native Codex/Claude permission hooks and rely on on-screen prompt detection.
# LIVE_ASSISTANT_HOOKS=1

# Chromium used by npm run test:browser and test:live.
# LIVE_ASSISTANT_CHROMIUM=/path/to/chrome
